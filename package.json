{
  "name": "subagent",
  "version": "0.5.6",
  "description": "CLI tool for managing workspace agents across VS Code",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "bin": {
    "subagent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/cli.ts",
    "start": "bun dist/cli.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "test": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration",
    "test:all": "bun test ./tests",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "cli",
    "agent",
    "workspace",
    "vscode",
    "automation",
    "parallel",
    "ai",
    "copilot",
    "subagent"
  ],
  "author": "EntityProcess",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EntityProcess/subagent.git"
  },
  "bugs": {
    "url": "https://github.com/EntityProcess/subagent/issues"
  },
  "homepage": "https://github.com/EntityProcess/subagent#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "json5": "^2.2.3",
    "pino": "^9.5.0",
    "rotating-file-stream": "^3.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
